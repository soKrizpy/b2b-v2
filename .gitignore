# See https://help.github.com/articles/ignoring-files/ for help with ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent scratch files
.agents/
# Keep only the committed project skill; all other agent scratch remains ignored.
!.agents/
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/b2b-project-doctor/
.agents/skills/b2b-project-doctor/*
!.agents/skills/b2b-project-doctor/SKILL.md
scratch/
.aistudio/
.vscode/
node_modules
node_modules
