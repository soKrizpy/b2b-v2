# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Modern Supabase API keys (recommended)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy variable names remain supported during migration; uncomment only if needed.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=
GEMINI_API_KEY=

# Demo data is disabled by default. Set true only for local/demo testing.
# NEXT_PUBLIC_USE_MOCK=false
