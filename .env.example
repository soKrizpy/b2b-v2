NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Extension features are enabled by default. Set to "false" to disable.
# Core learning features (auth, curriculum, sessions, teacher, challenges,
# quiz assessment) are always on and cannot be toggled.
#
# NEXT_PUBLIC_ENABLE_GAMIFICATION=false   # Pet system, XP, coins, cosmetics
# NEXT_PUBLIC_ENABLE_CERTIFICATES=false   # Tiered completion certificates
# NEXT_PUBLIC_ENABLE_BILLING=false        # Invoices & post-paid billing
# NEXT_PUBLIC_ENABLE_PARENT_PORTAL=false  # Parent report portal
# NEXT_PUBLIC_ENABLE_ANNOUNCEMENTS=false   # Admin broadcast banners
# NEXT_PUBLIC_ENABLE_AI=false             # Gemini chatbot & AI explanations
# NEXT_PUBLIC_ENABLE_QUEST_MAP=false       # Pixel-art quest map UI (progression stays)
